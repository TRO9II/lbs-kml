<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_solid">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Прицел инструментов (линейка / маршрут) -->
    <ImageView
        android:id="@+id/toolCross"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_crosshair"
        android:visibility="gone" />

    <!-- ВЕРХ: поиск, направления, плашки -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_hud_solid_pill"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_search"
                android:tint="@color/hud_text2" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/searchHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:text="Поиск · направления"
                    android:textColor="@color/hud_text2"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/searchBox"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Город, посёлок, село…"
                    android:imeOptions="actionSearch"
                    android:inputType="textCapWords"
                    android:paddingStart="4dp"
                    android:singleLine="true"
                    android:textColor="@color/hud_text"
                    android:textColorHint="@color/hud_text2"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnSearchClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_hud_btn"
                android:contentDescription="Закрыть поиск"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                android:tint="@color/hud_text2"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/resultsScroll"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_hud"
            android:elevation="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </ScrollView>

        <HorizontalScrollView
            android:id="@+id/chipsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/coordCard"
            style="@style/HudCard"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/coordSk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/hud_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/coordWgs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64B5F6"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/scaleRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <ru.lbs.kml.ScaleBarView
                    android:id="@+id/scaleBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/scaleBarText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/hud_text"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/scaleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/hud_text2"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/zoomText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/hud_text2"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/targetCard"
            style="@style/HudCard"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_flag"
                android:tint="#E040FB" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/targetMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/hud_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/targetSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hud_text2"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/targetClear"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_hud_btn"
                android:contentDescription="Сбросить цель"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="@color/hud_text2" />
        </LinearLayout>
    </LinearLayout>

    <!-- НИЗ: прогресс, атрибуция, масштаб, полка / панель инструмента -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/attribution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:layout_weight="1"
                android:gravity="start"
                android:shadowColor="#CC000000"
                android:shadowRadius="3"
                android:textColor="#E6FFFFFF"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hud_solid"
                android:elevation="6dp"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/btnCompass"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_hud_btn"
                    android:clickable="true"
                    android:contentDescription="Компас: вернуть на север"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/compassNeedle"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_compass" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/btnGrid"
                    style="@style/HudIcon"
                    android:contentDescription="Сетка СК-42"
                    android:src="@drawable/ic_grid" />

                <View style="@style/HudDivider" />

                <ImageView
                    android:id="@+id/btnZoomIn"
                    style="@style/HudIcon"
                    android:contentDescription="Приблизить"
                    android:src="@drawable/ic_add" />

                <ImageView
                    android:id="@+id/btnZoomOut"
                    style="@style/HudIcon"
                    android:contentDescription="Отдалить"
                    android:src="@drawable/ic_remove" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dlRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hud"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:indeterminateTint="@color/hud_accent" />

            <TextView
                android:id="@+id/dlText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hud_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dlCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hud_btn"
                android:padding="8dp"
                android:text="Отмена"
                android:textColor="@color/hud_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Полка инструментов -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_hud_solid_pill"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:padding="3dp">

            <LinearLayout
                android:id="@+id/dockLayers"
                style="@style/DockItem">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_layers" android:contentDescription="Слои" />
                <TextView style="@style/DockLabel" android:text="Слои" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/dockRuler"
                style="@style/DockItem">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_ruler" android:contentDescription="Линейка" />
                <TextView style="@style/DockLabel" android:text="Линейка" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/dockRoute"
                style="@style/DockItem">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_route" android:contentDescription="Маршрут" />
                <TextView style="@style/DockLabel" android:text="Маршрут" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/dockPoints"
                style="@style/DockItem">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_place" android:contentDescription="Точки" />
                <TextView style="@style/DockLabel" android:text="Точки" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/dockMenu"
                style="@style/DockItem">
                <FrameLayout android:layout_width="24dp" android:layout_height="24dp">
                    <ImageView style="@style/DockIcon" android:src="@drawable/ic_menu" android:contentDescription="Меню" />
                    <View android:id="@+id/menuBadge" android:layout_width="8dp" android:layout_height="8dp" android:layout_gravity="top|end" android:background="@drawable/bg_badge" android:visibility="gone" />
                </FrameLayout>
                <TextView style="@style/DockLabel" android:text="Меню" />
            </LinearLayout>
        </LinearLayout>

        <!-- Панель линейки / маршрута (компактная) -->
        <LinearLayout
            android:id="@+id/toolPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hud_solid"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/toolTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:textColor="@color/hud_amber"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/toolTotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/hud_text"
                    android:textSize="20sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/toolSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/hud_text2"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/toolCenter"
                    style="@style/ToolIcon"
                    android:contentDescription="Точка в центр"
                    android:src="@drawable/ic_crosshair_add" />
                <ImageView
                    android:id="@+id/toolUndo"
                    style="@style/ToolIcon"
                    android:contentDescription="Отменить"
                    android:src="@drawable/ic_undo" />
                <ImageView
                    android:id="@+id/toolClear"
                    style="@style/ToolIcon"
                    android:contentDescription="Очистить"
                    android:src="@drawable/ic_delete" />
                <ImageView
                    android:id="@+id/toolTable"
                    style="@style/ToolIcon"
                    android:contentDescription="Таблица"
                    android:src="@drawable/ic_table" />
                <ImageView
                    android:id="@+id/toolSave"
                    style="@style/ToolIcon"
                    android:contentDescription="Сохранить"
                    android:src="@drawable/ic_save" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/toolDone"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_accent_btn"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="Готово"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
