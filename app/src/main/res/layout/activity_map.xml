<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Сверху: парящая строка поиска + направления -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_search"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="2dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Назад"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/searchHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:text="🔍  Поиск населённого пункта"
                    android:textColor="@color/text2"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/searchBox"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Город, посёлок, село…"
                    android:imeOptions="actionSearch"
                    android:inputType="textCapWords"
                    android:paddingStart="4dp"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text2"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnSearchClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Закрыть поиск"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/text2"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Результаты поиска -->
        <ScrollView
            android:id="@+id/resultsScroll"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_float"
            android:elevation="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </ScrollView>

        <!-- Направления -->
        <HorizontalScrollView
            android:id="@+id/chipsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Справа: панель управления + масштаб -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_float"
            android:elevation="6dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/btnCompass"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:contentDescription="Компас: вернуть на север"
                android:focusable="true">

                <ImageView
                    android:id="@+id/compassNeedle"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_compass" />
            </FrameLayout>

            <View style="@style/MapDivider" />

            <TextView
                android:id="@+id/btnLayers"
                style="@style/MapIconBtn"
                android:contentDescription="Подложка карты"
                android:text="◫"
                android:textSize="22sp" />

            <View style="@style/MapDivider" />

            <TextView
                android:id="@+id/btnLabels"
                style="@style/MapIconBtn"
                android:contentDescription="Подписи на русском"
                android:fontFamily="sans-serif-medium"
                android:text="Аа"
                android:textSize="16sp" />

            <View style="@style/MapDivider" />

            <TextView
                android:id="@+id/btnDownload"
                style="@style/MapIconBtn"
                android:contentDescription="Скачать область"
                android:text="⬇" />

            <View style="@style/MapDivider" />

            <TextView
                android:id="@+id/btnInfo"
                style="@style/MapIconBtn"
                android:contentDescription="О карте"
                android:fontFamily="sans-serif-medium"
                android:text="i"
                android:textSize="19sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_float"
            android:elevation="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btnZoomIn"
                style="@style/MapIconBtn"
                android:contentDescription="Приблизить"
                android:text="+"
                android:textSize="26sp" />

            <View style="@style/MapDivider" />

            <TextView
                android:id="@+id/btnZoomOut"
                style="@style/MapIconBtn"
                android:contentDescription="Отдалить"
                android:text="−"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Снизу: прогресс скачивания + источник карты -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/dlRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_float"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/dlText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dlCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:text="Отмена"
                android:textColor="@color/accent"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/attribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
