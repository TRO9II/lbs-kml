<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_solid">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Прицел инструментов (линейка / маршрут) -->
    <ImageView
        android:id="@+id/toolCross"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_crosshair"
        android:visibility="gone" />

    <!-- ВЕРХ: поиск, направления, плашки -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_hud_pill"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="9dp"
                android:src="@drawable/ic_search"
                android:tint="@color/hud_text2" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/searchHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="4dp"
                    android:text="Поиск населённого пункта"
                    android:textColor="@color/hud_text2"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/searchBox"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Город, посёлок, село…"
                    android:imeOptions="actionSearch"
                    android:inputType="textCapWords"
                    android:paddingStart="4dp"
                    android:singleLine="true"
                    android:textColor="@color/hud_text"
                    android:textColorHint="@color/hud_text2"
                    android:textSize="16sp"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/btnSearchClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_hud_btn"
                android:contentDescription="Закрыть поиск"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                android:tint="@color/hud_text2"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/resultsScroll"
            android:layout_width="match_parent"
            android:layout_height="340dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_hud"
            android:elevation="6dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/results"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </ScrollView>

        <HorizontalScrollView
            android:id="@+id/chipsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- ЛБС не загружена -->
        <LinearLayout
            android:id="@+id/lbsBanner"
            style="@style/HudCard"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ЛБС ещё не загружена"
                android:textColor="@color/hud_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/lbsBannerBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_accent_btn"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Загрузить"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/coordCard"
            style="@style/HudCard"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/coordSk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/hud_text"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/coordWgs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#64B5F6"
                android:textSize="13.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/scaleCard"
            style="@style/HudCard"
            android:visibility="gone">

            <TextView
                android:id="@+id/scaleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hud_text"
                android:textSize="13.5sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <ru.lbs.kml.ScaleBarView
                    android:id="@+id/scaleBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp" />

                <TextView
                    android:id="@+id/scaleBarText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/hud_text"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/zoomText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="@color/hud_text2"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/targetCard"
            style="@style/HudCard"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_flag"
                android:tint="#E040FB" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/targetMain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/hud_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/targetSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hud_text2"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/targetClear"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_hud_btn"
                android:contentDescription="Сбросить цель"
                android:padding="8dp"
                android:src="@drawable/ic_close"
                android:tint="@color/hud_text2" />
        </LinearLayout>
    </LinearLayout>

    <!-- СПРАВА: компас и сетка -->
    <LinearLayout
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_hud"
        android:elevation="6dp"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/btnCompass"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_hud_btn"
            android:clickable="true"
            android:contentDescription="Компас: вернуть на север"
            android:focusable="true">

            <ImageView
                android:id="@+id/compassNeedle"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_compass" />
        </FrameLayout>

        <View style="@style/HudDivider" />

        <ImageView
            android:id="@+id/btnGrid"
            style="@style/HudIcon"
            android:contentDescription="Сетка СК-42"
            android:src="@drawable/ic_grid" />
    </LinearLayout>

    <!-- НИЗ: прогресс, атрибуция, масштаб, полка / панель инструмента -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/attribution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:layout_weight="1"
                android:gravity="start"
                android:shadowColor="#CC000000"
                android:shadowRadius="3"
                android:textColor="#E6FFFFFF"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hud"
                android:elevation="6dp"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnZoomIn"
                    style="@style/HudIcon"
                    android:contentDescription="Приблизить"
                    android:src="@drawable/ic_add" />

                <View style="@style/HudDivider" />

                <ImageView
                    android:id="@+id/btnZoomOut"
                    style="@style/HudIcon"
                    android:contentDescription="Отдалить"
                    android:src="@drawable/ic_remove" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dlRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_hud"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="10dp"
                android:indeterminateTint="@color/hud_accent" />

            <TextView
                android:id="@+id/dlText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hud_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dlCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hud_btn"
                android:padding="8dp"
                android:text="Отмена"
                android:textColor="@color/hud_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Полка инструментов -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_hud_pill"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:padding="5dp">

            <LinearLayout
                android:id="@+id/dockLayers"
                style="@style/DockItem">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_layers" android:contentDescription="Слои" />
                <TextView style="@style/DockLabel" android:text="Слои" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/dockRuler"
                style="@style/DockItem">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_ruler" android:contentDescription="Линейка" />
                <TextView style="@style/DockLabel" android:text="Линейка" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/dockRoute"
                style="@style/DockItem">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_route" android:contentDescription="Маршрут" />
                <TextView style="@style/DockLabel" android:text="Маршрут" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/dockPoints"
                style="@style/DockItem">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_place" android:contentDescription="Точки" />
                <TextView style="@style/DockLabel" android:text="Точки" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/dockMenu"
                style="@style/DockItem">
                <ImageView style="@style/DockIcon" android:src="@drawable/ic_menu" android:contentDescription="Меню" />
                <TextView style="@style/DockLabel" android:text="Меню" />
            </LinearLayout>
        </LinearLayout>

        <!-- Панель линейки / маршрута -->
        <LinearLayout
            android:id="@+id/toolPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_hud"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/toolTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:textColor="@color/hud_amber"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/toolTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/hud_text"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/toolSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/hud_text2"
                android:textSize="12.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/toolCenter"
                    style="@style/ToolBtn">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:tint="@color/hud_text" android:src="@drawable/ic_crosshair_add" android:contentDescription="В центр" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="В центр" android:textColor="@color/hud_text2" android:textSize="10.5sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/toolUndo"
                    style="@style/ToolBtn">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:tint="@color/hud_text" android:src="@drawable/ic_undo" android:contentDescription="Отменить" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Отменить" android:textColor="@color/hud_text2" android:textSize="10.5sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/toolClear"
                    style="@style/ToolBtn">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:tint="@color/hud_text" android:src="@drawable/ic_delete" android:contentDescription="Очистить" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Очистить" android:textColor="@color/hud_text2" android:textSize="10.5sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/toolTable"
                    style="@style/ToolBtn">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:tint="@color/hud_text" android:src="@drawable/ic_table" android:contentDescription="Таблица" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Таблица" android:textColor="@color/hud_text2" android:textSize="10.5sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/toolSave"
                    style="@style/ToolBtn">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:tint="@color/hud_text" android:src="@drawable/ic_save" android:contentDescription="Сохранить" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Сохранить" android:textColor="@color/hud_text2" android:textSize="10.5sp" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/toolDone"
                    style="@style/ToolBtn"
                android:background="@drawable/bg_accent_btn">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:tint="@android:color/white" android:src="@drawable/ic_check" android:contentDescription="Готово" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Готово" android:textColor="@android:color/white" android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
